{
  "name": "crucible.exe",
  "version": "1.0.0",
  "private": true,
  "description": "CRUCIBLE.EXE, a Game Boy Color cartridge: source, baked data and the release ROM.",
  "license": "MIT AND CC0-1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node tools/build-rom.ts",
    "verify": "node tools/build-rom.ts --verify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check . && node tools/check-c-format.ts",
    "format": "prettier --write . && node tools/check-c-format.ts --fix",
    "test": "node --test \"tools/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
